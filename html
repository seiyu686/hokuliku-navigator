function openKB(key){
  var d = KB[key];
  if(!d) return;
  var html = '<div class="modal-title">'+d.title+'</div>';
  d.secs.forEach(function(s){
    html += '<div class="ksec"><div class="ksec-title">'+s.t+'</div><div class="ksec-body">'+s.b.replace(/\n/g,'<br>')+'</div></div>';
  });
  document.getElementById('kbContent').innerHTML = html;
  document.getElementById('kbOverlay').classList.add('on');
}
function closeKB(){ document.getElementById('kbOverlay').classList.remove('on'); }

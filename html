<script>
// ── API KEY ──────────────────────────────────────────────
var apiKey = localStorage.getItem('bn_key') || '';
(function(){
  document.getElementById('kInput').value = apiKey;
  updateKeyUI(apiKey);
  document.getElementById('top-date').textContent = new Date().toLocaleDateString('en-GB',{weekday:'short',year:'numeric',month:'short',day:'numeric'});
})();

function onKey(v){
  apiKey = v.trim();
  localStorage.setItem('bn_key', apiKey);
  updateKeyUI(apiKey);
}
function updateKeyUI(k){
  var dot = document.getElementById('kdot');
  var st  = document.getElementById('key-status');
  if(k && k.length > 20){
    dot.className = 'key-dot ok';
    st.textContent = 'Connected';
    st.style.color = '#2d6a4f';
  } else {
    dot.className = 'key-dot';
    st.textContent = k ? 'Invalid key' : 'Not set — paste key above to enable AI chat';
    st.style.color = '#888';
  }
}

// ── NAVIGATION ───────────────────────────────────────────
function go(name, el){
  document.querySelectorAll('.panel').forEach(function(p){ p.classList.remove('on'); });
  document.querySelectorAll('.nav-item').forEach(function(n){ n.classList.remove('on'); });
  document.getElementById('panel-'+name).classList.add('on');
  el.classList.add('on');
  if(name === 'chat' && chatHistory.length === 0) initChat();
}

// ── TASKS ────────────────────────────────────────────────
var taskFilter = 'all';
var tasks = [];
var DEFAULT_TASKS = [
  {id:1, title:'Identify 3 target Hokuriku SMEs for first outreach', priority:'now', done:false},
  {id:2, title:'Prepare Trust Package sample for lacquerware category', priority:'now', done:false},
  {id:3, title:'Draft one-page service agreement with 2-month minimum clause', priority:'now', done:false},
  {id:4, title:'Open first SME conversation with a warm contact', priority:'now', done:false},
  {id:5, title:'Request JETRO introduction through university', priority:'soon', done:false},
  {id:6, title:'Run free website audit on a target SME before first meeting', priority:'soon', done:false},
  {id:7, title:'Set up WATI account for WhatsApp Business API', priority:'soon', done:false},
  {id:8, title:'Build n8n social posting pipeline (LinkedIn first)', priority:'soon', done:false},
  {id:9, title:'Set up Japan Sourcing Hub report template', priority:'later', done:false},
  {id:10, title:'Create WhatsApp agent knowledge base for first SME client', priority:'later', done:false}
];

(function(){
  var saved = localStorage.getItem('bn_tasks');
  tasks = saved ? JSON.parse(saved) : DEFAULT_TASKS.map(function(t){ return Object.assign({},t); });
  renderTasks();
})();

function saveTasks(){
  localStorage.setItem('bn_tasks', JSON.stringify(tasks));
  renderTasks();
}
function filt(f, el){
  taskFilter = f;
  document.querySelectorAll('.ftab').forEach(function(b){ b.classList.remove('on'); });
  el.classList.add('on');
  renderTasks();
}
function toggleAdd(){
  var f = document.getElementById('addForm');
  f.classList.toggle('on');
  if(f.classList.contains('on')) document.getElementById('newTitle').focus();
}
function addTask(){
  var title = document.getElementById('newTitle').value.trim();
  var pri   = document.getElementById('newPri').value;
  if(!title) return;
  tasks.push({id: Date.now(), title: title, priority: pri, done: false});
  document.getElementById('newTitle').value = '';
  document.getElementById('addForm').classList.remove('on');
  saveTasks();
}
function toggleTask(id){
  var t = tasks.find(function(x){ return x.id === id; });
  if(t){ t.done = !t.done; saveTasks(); }
}
function deleteTask(id){
  tasks = tasks.filter(function(x){ return x.id !== id; });
  saveTasks();
}
function renderTasks(){
  var show = taskFilter === 'all' ? tasks : tasks.filter(function(t){ return t.priority === taskFilter; });
  var groups = {now:'This week', soon:'Next 2–4 weeks', later:'Phase 2 onwards'};
  var html = '';
  ['now','soon','later'].forEach(function(p){
    var grp = show.filter(function(t){ return t.priority === p; });
    if(!grp.length) return;
    html += '<div class="tgroup"><div class="tgroup-label">'+groups[p]+'</div>';
    grp.forEach(function(t){
      html += '<div class="titem'+(t.done?' done':'')+'">'
        +'<div class="tcheck'+(t.done?' on':'')+'" onclick="toggleTask('+t.id+')">'+(t.done?'✓':'')+'</div>'
        +'<div class="tbody"><div class="ttext">'+t.title+'</div>'
        +'<div><span class="ttag '+t.priority+'">'+(p==='now'?'This week':p==='soon'?'Soon':'Later')+'</span></div></div>'
        +'<div class="tactions"><button class="btn btn-d" onclick="deleteTask('+t.id+')">✕</button></div>'
        +'</div>';
    });
    html += '</div>';
  });
  if(!html) html = '<p style="color:var(--ink3);font-size:12px;padding:16px 0">No tasks in this view.</p>';
  document.getElementById('taskList').innerHTML = html;
  document.getElementById('tbadge').textContent = tasks.filter(function(t){ return !t.done; }).length;
}

// ── CHAT ─────────────────────────────────────────────────
var chatHistory = [];
var SYS = 'You are the Hokuriku Bridge Navigator — a strategic business agent for a trilingual graduate student in Hokuriku, Japan (Japanese, English, Chinese) building a consultancy helping Japanese SMEs expand internationally.\n\nFULL CONTEXT:\n\nPHASE 1 (current): SME Marketing Retainer. Embedded Cultural Navigator for Hokuriku manufacturers. Retainer ¥60K–100K/month. Entry: Trust Package ¥80K–150K one-time. Add-on: Managed inquiry handling ¥20K–30K/month. Protection: ¥25K non-refundable onboarding, 2-month minimum, 50/50 milestone payments. Target: craft manufacturers — lacquerware, metalwork, textiles, precision parts.\n\nPHASE 2: Japan Sourcing Hub — intelligence reports for foreign importers, $299–799/report.\n\nPHASE 3: Japan Export Intelligence — B2B subscription, export market dashboards.\n\nTHREE-LAYER SERVICE:\n1. Trust Package: English capability statement, compliance checklist, English FAQ, nemawashi guide reframing slow decisions as a strength.\n2. Communication Bridge: all foreign inquiries translated/routed, meeting prep notes, indirect cue interpretation (silence ≠ disinterest).\n3. Foreign Buyer Advisory: supplier onboarding, shokai introductions, ringi coaching.\n\nTECH STACK (n8n): Social pipeline: cron → Claude API → Google Sheets → LinkedIn/Instagram → client email. Email pipeline: Gmail trigger → Claude translate → SME inbox → Japanese reply → translate → send. WhatsApp agent: WATI ($40/mo) → Claude intent classification → auto-reply/translate-forward/escalate.\n\nJAPAN 10 PAIN POINTS: 1.Nemawashi/ringi (never force decisions, silence=building consensus) 2.Opaque hierarchies (real decision-maker often silent) 3.Keiretsu networks (shokai introductions only) 4.Language deeper than translation (indirect refusals, face-saving) 5.Extreme quality demands 6.Supplier loyalty/giri 7.Risk aversion 8.Regulatory complexity PSE/METI 9.Bilingual talent scarcity 10.Multi-layer distribution price erosion.\n\nPITCH SCRIPTS: In-person JP: 「最近、海外展開に興味があるとお聞きしました。実は私、金沢大学の研究者をしながら、北陸のメーカーさんが海外のバイヤーと繋がるお手伝いをしているんです。」 Cold email subject: 海外バイヤーへの発信について、少しご相談できますか Closing: 「まずは3ヶ月、お試しで。成果が出なければ続ける必要はありません。」 Free audit offer as door-opener.\n\nREVENUE (3 clients): ¥3.78M/year. CULTURAL: Nemawashi, Uchi/Soto, Shokai, Giri, Meiwaku avoidance.\n\nYOUR ADVANTAGE: Trilingual JP+EN+CN, physically in Hokuriku, graduate researcher credibility, lives in both cultures.\n\nAlways give specific, actionable advice. Provide complete scripts and templates when asked. Be direct but warm.';

function initChat(){
  chatHistory.push({role:'assistant', content:'こんにちは！ I\'m your Hokuriku Bridge Navigator — I have full context of your business strategy, all three phases, pitch scripts, pricing, Japan pain points, and n8n pipelines.\n\nAsk me anything: next steps, how to handle a specific situation, Japanese email drafts, pricing questions, or automation setup. What\'s on your mind?'});
  renderMsgs();
}
function renderMsgs(){
  var c = document.getElementById('chatMsgs');
  c.innerHTML = '';
  chatHistory.forEach(function(m){
    var d = document.createElement('div');
    d.className = 'msg ' + (m.role==='user' ? 'u' : 'a');
    var fmt = m.content.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\n/g,'<br>').replace(/\*\*(.*?)\*\*/g,'<strong>$1</strong>');
    d.innerHTML = '<div class="avatar">'+(m.role==='user'?'You':'橋')+'</div><div class="bubble">'+fmt+'</div>';
    c.appendChild(d);
  });
  c.scrollTop = c.scrollHeight;
}
function addTyping(){
  var c = document.getElementById('chatMsgs');
  var d = document.createElement('div');
  d.className='msg a'; d.id='typing';
  d.innerHTML='<div class="avatar">橋</div><div class="typing"><span></span><span></span><span></span></div>';
  c.appendChild(d); c.scrollTop=c.scrollHeight;
}
function removeTyping(){ var t=document.getElementById('typing'); if(t) t.remove(); }

function send(){
  if(!apiKey || apiKey.length < 20){
    alert('Please paste your Anthropic API key in the bar at the top.\n\nGet a free key at: console.anthropic.com → API Keys\n\nThe key starts with sk-ant-...');
    return;
  }
  var inp = document.getElementById('chatIn');
  var txt = inp.value.trim();
  if(!txt) return;
  inp.value = '';
  chatHistory.push({role:'user', content:txt});
  renderMsgs();
  document.getElementById('sendBtn').disabled = true;
  addTyping();

  var msgs = chatHistory.slice(0,-1).map(function(m){ return {role:m.role, content:m.content}; });
  msgs.push({role:'user', content:txt});

  fetch('https://api.anthropic.com/v1/messages', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'x-api-key': apiKey,
      'anthropic-version': '2023-06-01',
      'anthropic-dangerous-direct-browser-access': 'true'
    },
    body: JSON.stringify({
      model: 'claude-sonnet-4-20250514',
      max_tokens: 1024,
      system: SYS,
      messages: msgs
    })
  })
  .then(function(r){ return r.json(); })
  .then(function(data){
    removeTyping();
    var reply = (data.content && data.content[0] && data.content[0].text) ? data.content[0].text : (data.error ? 'Error: '+data.error.message : 'No response received.');
    chatHistory.push({role:'assistant', content:reply});
    renderMsgs();
  })
  .catch(function(e){
    removeTyping();
    chatHistory.push({role:'assistant', content:'Connection error: '+e.message+'\n\nPlease check your API key and internet connection.'});
    renderMsgs();
  })
  .finally(function(){
    document.getElementById('sendBtn').disabled = false;
  });
}

function q(text){
  go('chat', document.getElementById('nav-chat'));
  setTimeout(function(){
    document.getElementById('chatIn').value = text;
    send();
  }, chatHistory.length===0 ? 200 : 0);
}


<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>北陸 Bridge Navigator</title>
<link href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@400;700&family=DM+Sans:wght@300;400;500&family=DM+Mono&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --ink:#16160e;--ink2:#3d3c30;--ink3:#7a7868;
  --paper:#f7f5ef;--paper2:#eeeade;
  --accent:#b5341c;--accent2:#d4873a;--gold:#c9a84c;
  --border:#d8d4c0;--surface:#fff;
  --green:#2d6a4f;--blue:#1a4a7a;
}
html,body{height:100%;overflow:hidden}
body{font-family:'DM Sans',sans-serif;background:var(--paper);color:var(--ink);font-size:14px}
.app{display:grid;grid-template-columns:200px 1fr;grid-template-rows:52px 32px 1fr;height:100vh}

/* topbar */
.topbar{grid-column:1/-1;background:var(--ink);display:flex;align-items:center;padding:0 20px;gap:12px;border-bottom:2px solid var(--accent)}
.logo{font-family:'Shippori Mincho',serif;color:#fff;font-size:16px}
.logo b{color:var(--gold)}
.chip{font-size:10px;background:rgba(255,255,255,.08);color:#aaa;padding:2px 8px;border-radius:20px;border:1px solid rgba(255,255,255,.1)}
.chip.live::before{content:'● ';color:var(--green)}
#top-date{margin-left:auto;font-size:11px;color:#555;font-family:'DM Mono',monospace}

/* keybar */
.keybar{grid-column:1/-1;background:#0f0f0a;display:flex;align-items:center;padding:0 20px;gap:8px;font-size:11px;color:#666;border-bottom:1px solid #222}
.key-dot{width:7px;height:7px;border-radius:50%;flex-shrink:0;background:#444}
.key-dot.ok{background:var(--green)}
.keybar input{background:transparent;border:none;color:#999;font-family:'DM Mono',monospace;font-size:11px;flex:1;outline:none;min-width:0}
.keybar input::placeholder{color:#444}
#key-status{white-space:nowrap;color:#555}

/* sidebar */
.sidebar{background:var(--ink);padding:12px 0;overflow-y:auto}
.nav-group{font-size:9px;letter-spacing:.12em;text-transform:uppercase;color:#444;padding:12px 16px 4px}
.nav-item{display:flex;align-items:center;gap:8px;padding:9px 18px;cursor:pointer;color:#888;font-size:12px;border-left:2px solid transparent;transition:all .15s}
.nav-item:hover{color:#fff;background:rgba(255,255,255,.04)}
.nav-item.on{color:#fff;border-left-color:var(--accent);background:rgba(181,52,28,.1)}
.nav-item .dot{width:5px;height:5px;border-radius:50%;background:currentColor;flex-shrink:0}
#tbadge{margin-left:auto;background:var(--accent);color:#fff;font-size:9px;padding:1px 5px;border-radius:8px;min-width:16px;text-align:center}

/* main area */
.main{overflow:hidden;display:flex;flex-direction:column}
.panel{display:none;flex:1;flex-direction:column;overflow:hidden}
.panel.on{display:flex}
.scroll{flex:1;overflow-y:auto;padding:24px}

/* cards */
.page-title{font-family:'Shippori Mincho',serif;font-size:22px;margin-bottom:4px}
.page-sub{font-size:12px;color:var(--ink3);margin-bottom:20px;line-height:1.6}
.cards3{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:16px}
.card{background:var(--surface);border:1px solid var(--border);border-radius:6px;padding:16px;position:relative;overflow:hidden}
.card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--border)}
.card.r::before{background:var(--accent)}
.card.a::before{background:var(--accent2)}
.card.g::before{background:var(--green)}
.card.b::before{background:var(--blue)}
.card.o::before{background:var(--gold)}
.clabel{font-size:9px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink3);margin-bottom:6px}
.cval{font-family:'Shippori Mincho',serif;font-size:26px;color:var(--ink);margin-bottom:2px}
.cdesc{font-size:11px;color:var(--ink3)}
.phases{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:16px}
.pcard{background:var(--surface);border:1px solid var(--border);border-radius:6px;padding:16px}
.pnum{font-family:'DM Mono',monospace;font-size:10px;color:var(--ink3);margin-bottom:6px}
.ptitle{font-weight:500;font-size:13px;margin-bottom:6px}
.pbadge{display:inline-block;font-size:10px;padding:2px 10px;border-radius:20px;margin-bottom:10px}
.pbadge.now{background:#fef3e2;color:#92400e}
.pbadge.build{background:#f0f0ee;color:#666}
.pbadge.future{background:#e8f5e9;color:#1b5e20}
.plist{list-style:none;font-size:11px;color:var(--ink2);line-height:1.9}
.plist li::before{content:'→ ';color:var(--ink3)}

/* tasks */
.toolbar{display:flex;align-items:center;gap:10px;margin-bottom:16px;flex-wrap:wrap}
.ttitle{font-family:'Shippori Mincho',serif;font-size:20px;flex:1}
.ftabs{display:flex;gap:3px;background:var(--paper2);padding:3px;border-radius:4px}
.ftab{padding:4px 10px;border-radius:3px;font-size:11px;cursor:pointer;color:var(--ink3);border:none;background:transparent;font-family:'DM Sans',sans-serif;transition:all .15s}
.ftab.on{background:#fff;color:var(--ink);box-shadow:0 1px 3px rgba(0,0,0,.1)}
.btn{padding:7px 14px;border:none;border-radius:4px;font-size:12px;font-family:'DM Sans',sans-serif;cursor:pointer;font-weight:500;transition:all .15s}
.btn-p{background:var(--accent);color:#fff}
.btn-p:hover{background:#9a2a14}
.btn-p:disabled{background:#ccc;cursor:not-allowed}
.btn-g{background:transparent;color:var(--ink2);border:1px solid var(--border)}
.btn-g:hover{background:var(--paper2)}
.btn-d{background:transparent;color:var(--accent);border:1px solid var(--border);padding:4px 8px;font-size:11px}
.add-form{background:var(--surface);border:1px solid var(--border);border-radius:4px;padding:14px;margin-bottom:14px;display:none}
.add-form.on{display:block}
.add-row{display:grid;grid-template-columns:1fr auto auto;gap:8px}
input[type=text],select,textarea{width:100%;padding:8px 11px;border:1.5px solid var(--border);border-radius:4px;font-size:12px;font-family:'DM Sans',sans-serif;color:var(--ink);background:var(--surface);outline:none;transition:border-color .15s}
input:focus,select:focus,textarea:focus{border-color:var(--accent)}
.tgroup{margin-bottom:20px}
.tgroup-label{font-size:9px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink3);padding-bottom:8px;border-bottom:1px solid var(--border);margin-bottom:10px}
.titem{display:flex;align-items:flex-start;gap:10px;padding:10px 12px;background:var(--surface);border:1px solid var(--border);border-radius:4px;margin-bottom:6px;transition:border-color .15s}
.titem:hover{border-color:var(--ink3)}
.titem:hover .tactions{opacity:1}
.titem.done{opacity:.5}
.tcheck{width:16px;height:16px;border-radius:3px;border:1.5px solid var(--border);cursor:pointer;flex-shrink:0;margin-top:1px;display:flex;align-items:center;justify-content:center;font-size:9px;transition:all .15s}
.tcheck.on{background:var(--green);border-color:var(--green);color:#fff}
.tbody{flex:1}
.ttext{font-size:12px;font-weight:500;margin-bottom:3px;line-height:1.4}
.titem.done .ttext{text-decoration:line-through;color:var(--ink3)}
.ttag{font-size:9px;padding:2px 7px;border-radius:10px;font-weight:500;display:inline-block}
.ttag.now{background:#fee2e2;color:#991b1b}
.ttag.soon{background:#fef3e2;color:#92400e}
.ttag.later{background:#e8f5e9;color:#1b5e20}
.tactions{opacity:0;transition:opacity .15s}

/* chat */
.chat-wrap{flex:1;display:grid;grid-template-columns:1fr 240px;overflow:hidden}
.chat-main{display:flex;flex-direction:column;overflow:hidden;border-right:1px solid var(--border)}
.chat-msgs{flex:1;overflow-y:auto;padding:20px;display:flex;flex-direction:column;gap:14px}
.msg{display:flex;gap:10px;max-width:88%}
.msg.u{align-self:flex-end;flex-direction:row-reverse}
.avatar{width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:600;flex-shrink:0;font-family:'Shippori Mincho',serif}
.msg.u .avatar{background:var(--ink);color:#fff}
.msg.a .avatar{background:var(--accent);color:#fff}
.bubble{padding:10px 14px;border-radius:8px;font-size:12px;line-height:1.75}
.msg.u .bubble{background:var(--ink);color:#fff;border-radius:8px 2px 8px 8px}
.msg.a .bubble{background:var(--surface);border:1px solid var(--border);border-radius:2px 8px 8px 8px}
.chat-foot{padding:14px 16px;border-top:1px solid var(--border);background:var(--surface)}
.chat-row{display:flex;gap:8px;align-items:flex-end}
textarea.cinput{min-height:40px;max-height:100px;resize:none;padding:9px 12px;font-size:12px}
.csend{padding:9px 16px;background:var(--accent);color:#fff;border:none;border-radius:4px;cursor:pointer;font-size:12px;font-family:'DM Sans',sans-serif;font-weight:500;white-space:nowrap;transition:background .15s;flex-shrink:0}
.csend:hover{background:#9a2a14}
.csend:disabled{background:#ccc;cursor:not-allowed}
.chat-side{padding:16px;overflow-y:auto;background:var(--paper)}
.side-title{font-size:9px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink3);margin-bottom:10px;margin-top:14px}
.side-title:first-child{margin-top:0}
.qbtn{display:block;width:100%;text-align:left;padding:8px 10px;background:var(--surface);border:1px solid var(--border);border-radius:4px;font-size:11px;color:var(--ink2);cursor:pointer;margin-bottom:5px;line-height:1.4;transition:all .15s;font-family:'DM Sans',sans-serif}
.qbtn:hover{border-color:var(--accent);color:var(--accent)}
.typing{display:flex;gap:4px;align-items:center;padding:10px 14px;background:var(--surface);border:1px solid var(--border);border-radius:2px 8px 8px 8px}
.typing span{width:5px;height:5px;border-radius:50%;background:var(--ink3);animation:bou .9s infinite}
.typing span:nth-child(2){animation-delay:.15s}
.typing span:nth-child(3){animation-delay:.3s}
@keyframes bou{0%,80%,100%{transform:translateY(0)}40%{transform:translateY(-5px)}}

/* knowledge */
.kb-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.kcard{background:var(--surface);border:1px solid var(--border);border-radius:6px;padding:16px;cursor:pointer;transition:all .15s}
.kcard:hover{border-color:var(--ink3);transform:translateY(-1px)}
.kcard-icon{font-size:18px;margin-bottom:8px}
.kcard-title{font-weight:600;font-size:12px;margin-bottom:4px}
.kcard-desc{font-size:11px;color:var(--ink3);line-height:1.5}
.overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:200;align-items:center;justify-content:center;padding:30px}
.overlay.on{display:flex}
.modal{background:#fff;border-radius:8px;max-width:600px;width:100%;max-height:82vh;overflow-y:auto;padding:24px;position:relative}
.modal-x{position:absolute;top:12px;right:14px;cursor:pointer;font-size:18px;color:var(--ink3);background:none;border:none;line-height:1}
.modal-title{font-family:'Shippori Mincho',serif;font-size:18px;margin-bottom:14px}
.ksec{margin-bottom:14px}
.ksec-title{font-size:9px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink3);margin-bottom:4px}
.ksec-body{font-size:12px;line-height:1.8;color:var(--ink2)}

/* revenue */
table{width:100%;border-collapse:collapse;background:#fff;border-radius:6px;overflow:hidden;border:1px solid var(--border);margin-bottom:20px}
th{background:var(--ink);color:#fff;padding:9px 12px;font-size:10px;letter-spacing:.08em;text-transform:uppercase;font-weight:500;text-align:left}
td{padding:10px 12px;font-size:12px;border-bottom:1px solid var(--border);color:var(--ink2)}
tr:last-child td{border-bottom:none}
tr:hover td{background:var(--paper)}
.rev-total{font-family:'Shippori Mincho',serif;font-size:22px;color:var(--green)}
.rev-box{background:var(--surface);border:1px solid var(--border);border-radius:6px;padding:18px;margin-bottom:20px}
</style>
</head>
<body>
<div class="app">

<!-- TOP BAR -->
<div class="topbar">
  <span class="logo">北陸 <b>Bridge</b> Navigator</span>
  <span class="chip live">Agent active</span>
  <span class="chip">Hokuriku SME</span>
  <span class="chip">3-phase strategy</span>
  <span id="top-date"></span>
</div>

<!-- API KEY BAR -->
<div class="keybar">
  <span class="key-dot" id="kdot"></span>
  <span>API Key:</span>
  <input type="password" id="kInput" placeholder="Paste your Anthropic API key here  (sk-ant-...)" oninput="onKey(this.value)">
  <span id="key-status">Not set</span>
</div>

<!-- SIDEBAR -->
<div class="sidebar">
  <div class="nav-group">Command</div>
  <div class="nav-item on" id="nav-dash" onclick="go('dash',this)"><span class="dot"></span>Dashboard</div>
  <div class="nav-item" id="nav-tasks" onclick="go('tasks',this)"><span class="dot"></span>Tasks<span id="tbadge">0</span></div>
  <div class="nav-item" id="nav-chat" onclick="go('chat',this)"><span class="dot"></span>Strategy Agent</div>
  <div class="nav-group">Reference</div>
  <div class="nav-item" id="nav-kb" onclick="go('kb',this)"><span class="dot"></span>Knowledge Base</div>
  <div class="nav-item" id="nav-rev" onclick="go('rev',this)"><span class="dot"></span>Revenue Model</div>
</div>

<!-- MAIN -->
<div class="main">

<!-- DASHBOARD -->
<div class="panel on" id="panel-dash">
<div class="scroll">
  <div class="page-title">Your Japan Export Business</div>
  <div class="page-sub">Embedded Cultural Navigator · Hokuriku SME Marketing · Japan Sourcing Hub</div>
  <div class="cards3">
    <div class="card r"><div class="clabel">Current Phase</div><div class="cval">1</div><div class="cdesc">SME Marketing Retainer</div></div>
    <div class="card a"><div class="clabel">Target Clients</div><div class="cval">3</div><div class="cdesc">Hokuriku manufacturers</div></div>
    <div class="card g"><div class="clabel">Est. Annual Revenue</div><div class="cval">¥3.78M</div><div class="cdesc">3 clients × ¥1.26M</div></div>
  </div>
  <div class="phases">
    <div class="pcard">
      <div class="pnum">Phase 01 / Now</div><div class="ptitle">SME Marketing Retainer</div>
      <div class="pbadge now">● Active</div>
      <ul class="plist"><li>First SME outreach</li><li>Trust Package delivery</li><li>Retainer conversion</li><li>WhatsApp agent setup</li><li>n8n social pipeline</li></ul>
    </div>
    <div class="pcard">
      <div class="pnum">Phase 02 / Near-term</div><div class="ptitle">Japan Sourcing Hub</div>
      <div class="pbadge build">◌ Building</div>
      <ul class="plist"><li>Report templates ready</li><li>Inbound demand growth</li><li>SME case studies</li><li>$299–799 tier reports</li></ul>
    </div>
    <div class="pcard">
      <div class="pnum">Phase 03 / Long-term</div><div class="ptitle">Japan Export Intelligence</div>
      <div class="pbadge future">◎ Future</div>
      <ul class="plist"><li>Subscription product</li><li>Export market dashboards</li><li>B2B intelligence tiers</li><li>Regional credibility</li></ul>
    </div>
  </div>
  <div class="cards3">
    <div class="card a"><div class="clabel">Entry Point</div><div class="cval" style="font-size:15px;margin-top:4px">Trust Package</div><div class="cdesc">¥120,000 one-time project</div></div>
    <div class="card b"><div class="clabel">Monthly Retainer</div><div class="cval">¥80K</div><div class="cdesc">Per SME client / month</div></div>
    <div class="card o"><div class="clabel">Your Advantage</div><div class="cval" style="font-size:15px;margin-top:4px">Trilingual</div><div class="cdesc">JP + EN + CN · Hokuriku embedded</div></div>
  </div>
</div>
</div>

<!-- TASKS -->
<div class="panel" id="panel-tasks">
<div class="scroll">
  <div class="toolbar">
    <div class="ttitle">Task Tracker</div>
    <div class="ftabs">
      <button class="ftab on" onclick="filt('all',this)">All</button>
      <button class="ftab" onclick="filt('now',this)">Now</button>
      <button class="ftab" onclick="filt('soon',this)">Soon</button>
      <button class="ftab" onclick="filt('later',this)">Later</button>
    </div>
    <button class="btn btn-p" onclick="toggleAdd()">+ Add task</button>
  </div>
  <div class="add-form" id="addForm">
    <div class="add-row">
      <input type="text" id="newTitle" placeholder="Task description..." onkeydown="if(event.key==='Enter')addTask()">
      <select id="newPri"><option value="now">Now</option><option value="soon" selected>Soon</option><option value="later">Later</option></select>
      <button class="btn btn-p" onclick="addTask()">Save</button>
    </div>
  </div>
  <div id="taskList"></div>
</div>
</div>

<!-- CHAT -->
<div class="panel" id="panel-chat">
<div class="chat-wrap">
  <div class="chat-main">
    <div class="chat-msgs" id="chatMsgs"></div>
    <div class="chat-foot">
      <div class="chat-row">
        <textarea class="cinput" id="chatIn" placeholder="Ask about strategy, pitch scripts, pricing, next steps..." rows="1" onkeydown="if(event.key==='Enter'&&!event.shiftKey){event.preventDefault();send()}"></textarea>
        <button class="csend" id="sendBtn" onclick="send()">Send</button>
      </div>
    </div>
  </div>
  <div class="chat-side">
    <div class="side-title">Quick prompts</div>
    <button class="qbtn" onclick="q('What should I do this week to get my first SME client?')">What to do this week?</button>
    <button class="qbtn" onclick="q('Draft a cold email in Japanese to a Hokuriku manufacturer.')">Cold email in Japanese</button>
    <button class="qbtn" onclick="q('What should I include in the Trust Package for a lacquerware SME?')">Trust Package contents</button>
    <button class="qbtn" onclick="q('How do I handle early contract termination by an SME client?')">Handle early termination</button>
    <button class="qbtn" onclick="q('Explain the n8n WhatsApp agent setup step by step.')">n8n WhatsApp setup</button>
    <button class="qbtn" onclick="q('What is my competitive advantage over a regular marketing agency?')">My competitive advantage</button>
    <button class="qbtn" onclick="q('How do I price the foreign buyer advisory service?')">Pricing the advisory</button>
    <div class="side-title">Active context</div>
    <div style="display:flex;flex-wrap:wrap;gap:4px">
      <span class="chip" style="font-size:10px">SME retainer</span>
      <span class="chip" style="font-size:10px">n8n pipelines</span>
      <span class="chip" style="font-size:10px">Trust Package</span>
      <span class="chip" style="font-size:10px">WhatsApp agent</span>
      <span class="chip" style="font-size:10px">Japan pain points</span>
      <span class="chip" style="font-size:10px">Pitch scripts</span>
    </div>
  </div>
</div>
</div>

<!-- KNOWLEDGE BASE -->
<div class="panel" id="panel-kb">
<div class="scroll">
  <div class="page-title">Knowledge Base</div>
  <div class="page-sub">Click any card to expand the full reference.</div>
  <div class="kb-grid">
    <div class="kcard" onclick="openKB('model')"><div class="kcard-icon">🏗</div><div class="kcard-title">Embedded Cultural Navigator Model</div><div class="kcard-desc">3-layer service architecture, win-win framework, cultural alignment principles.</div></div>
    <div class="kcard" onclick="openKB('pitch')"><div class="kcard-icon">🗣</div><div class="kcard-title">Pitch Scripts & First Contact</div><div class="kcard-desc">In-person, cold email, JETRO intro scripts in Japanese and English.</div></div>
    <div class="kcard" onclick="openKB('services')"><div class="kcard-icon">📦</div><div class="kcard-title">Service Packages & Pricing</div><div class="kcard-desc">Trust Package, retainer tiers, add-ons, onboarding fee structure.</div></div>
    <div class="kcard" onclick="openKB('protection')"><div class="kcard-icon">🛡</div><div class="kcard-title">Client Protection Clauses</div><div class="kcard-desc">2-month minimum, onboarding fee, milestone payments, contract terms.</div></div>
    <div class="kcard" onclick="openKB('tech')"><div class="kcard-icon">⚙️</div><div class="kcard-title">Tech Stack & Automations</div><div class="kcard-desc">n8n pipelines: social, email translation, WhatsApp agent.</div></div>
    <div class="kcard" onclick="openKB('japan')"><div class="kcard-icon">🇯🇵</div><div class="kcard-title">Japan Market Pain Points</div><div class="kcard-desc">10 structural pain points: nemawashi, keiretsu, giri, language gap.</div></div>
  </div>
</div>
<div class="overlay" id="kbOverlay" onclick="if(event.target===this)closeKB()">
  <div class="modal"><button class="modal-x" onclick="closeKB()">✕</button><div id="kbContent"></div></div>
</div>
</div>

<!-- REVENUE -->
<div class="panel" id="panel-rev">
<div class="scroll">
  <div class="page-title">Revenue Model</div>
  <div class="page-sub">Pricing tiers, milestone structure, and annual projections.</div>
  <table>
    <thead><tr><th>Service</th><th>Type</th><th>Price</th><th>Frequency</th></tr></thead>
    <tbody>
      <tr><td>Trust Package</td><td>Project</td><td>¥80,000–150,000</td><td>One-time per client</td></tr>
      <tr><td>Communication Bridge Retainer</td><td>Retainer</td><td>¥60,000–100,000</td><td>Monthly</td></tr>
      <tr><td>Managed Inquiry Handling</td><td>Add-on</td><td>¥20,000–30,000</td><td>Monthly</td></tr>
      <tr><td>Foreign Buyer Advisory</td><td>Consulting</td><td>¥30,000–80,000</td><td>Per engagement</td></tr>
      <tr><td>Shokai (referral) introduction</td><td>Referral</td><td>¥50,000–100,000</td><td>Per intro</td></tr>
      <tr><td>Japan Sourcing Hub report</td><td>Product</td><td>$299–799</td><td>Per report</td></tr>
      <tr><td>Onboarding protection fee</td><td>One-time</td><td>¥25,000</td><td>Before month 1</td></tr>
    </tbody>
  </table>
  <div class="rev-box">
    <div style="font-size:11px;color:var(--ink3);margin-bottom:4px">Estimated annual revenue — 3 clients</div>
    <div class="rev-total">¥3,780,000 / year</div>
    <div style="font-size:11px;color:var(--ink3);margin-top:6px">Trust Packages ¥360K + Retainers ¥2.88M + Advisory ¥360K + Other ¥180K</div>
  </div>
  <table>
    <thead><tr><th>Milestone</th><th>Trigger</th><th>Min. Guaranteed</th></tr></thead>
    <tbody>
      <tr><td>Before work starts</td><td>Onboarding fee</td><td>¥25,000</td></tr>
      <tr><td>Month 1 start</td><td>50% retainer upfront</td><td>¥25,000–50,000</td></tr>
      <tr><td>Month 1 delivery</td><td>50% on output delivery</td><td>¥25,000–50,000</td></tr>
